APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# "localhost" here assumes Postgres/Redis are reached from your host machine (e.g. `docker run
# -p 5432:5432 ...`, or `alembic`/`uvicorn` run directly outside Docker). Running the backend
# itself inside docker-compose overrides these to the "db"/"redis" service hostnames instead —
# see docker-compose.yml — so you don't need to change this file for that path.
DATABASE_URL=postgresql+asyncpg://pmtool:pmtool@localhost:5432/pmtool

REDIS_URL=redis://localhost:6379/0

# Self-hosted GitLab instance (PRD Section 18: self-hosted, resolved)
GITLAB_INSTANCE_URL=https://gitlab.example.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
GITLAB_OAUTH_SCOPES=read_api read_user

# Org-wide service account token for background sync jobs (webhook processing, reconciliation)
# — a personal/project access token with api scope on a dedicated service account, never a
# per-user token (NFR Section 14).
GITLAB_SYNC_SERVICE_TOKEN=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
